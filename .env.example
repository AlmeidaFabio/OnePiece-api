# Copie para .env e ajuste os valores: cp .env.example .env
# As obrigatórias são DATABASE_URL e JWT_SECRET — sem elas a aplicação não sobe.

# Ambiente: development | production
NODE_ENV=development

# Portas: PORT vale em desenvolvimento; HTTP_PORT e HTTPS_PORT em produção
PORT=9000
HTTP_PORT=80
HTTPS_PORT=443

# Certificados TLS (obrigatórios quando NODE_ENV=production)
SSL_KEY=/etc/ssl/private/key.pem
SSL_CERT=/etc/ssl/certs/cert.pem

# URL base exibida na página inicial (GET /api)
BASE_URL=http://localhost

# Banco de dados
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/onepiece
# Abaixo, apenas para o docker-compose (a aplicação não lê estas)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=onepiece

# Sessão
JWT_SECRET=troque-por-um-segredo-aleatorio-de-32-caracteres-ou-mais
JWT_EXPIRES_IN=1d

# CORS: origens permitidas separadas por vírgula.
# Vazio = qualquer origem é aceita, com aviso no boot.
CORS_ORIGINS=

# Proxy: número de hops confiáveis, ou IP/sub-rede.
# Necessário atrás de proxy para o rate limit do login enxergar o IP real.
TRUST_PROXY=

# Testes: banco separado. Se ausente, usa DATABASE_URL com o sufixo _test.
# TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/onepiece_test

# Criação do primeiro admin por CLI (alternativa a passar por argumento)
# ADMIN_EMAIL=admin@exemplo.com
# ADMIN_PASSWORD=SuaSenha1!
