{
    "name": "one_piece_api",
    "version": "2.0.0",
    "description": "",
    "main": "build/server.js",
    "scripts": {
        "test": "vitest run",
        "test:watch": "vitest",
        "typecheck": "tsc -p tsconfig.test.json",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "build": "tsc",
        "postinstall": "prisma generate",
        "start": "node build/server.js",
        "dev": "ts-node-dev --transpile-only --ignore-watch node_modules src/server.ts",
        "prisma:generate": "prisma generate",
        "prisma:migrate": "prisma migrate dev",
        "prisma:studio": "prisma studio",
        "seed": "ts-node src/database/seed.ts",
        "admin:create": "ts-node src/database/createAdmin.ts"
    },
    "keywords": [
        "node",
        "typescript"
    ],
    "author": "AlmeidaFabio",
    "license": "MIT",
    "engines": {
        "node": ">=20.9.0"
    },
    "dependencies": {
        "@prisma/adapter-pg": "^7.8.0",
        "@prisma/client": "^7.8.0",
        "bcrypt": "^5.0.1",
        "cors": "^2.8.5",
        "dotenv": "^17.4.2",
        "express": "^4.18.1",
        "express-rate-limit": "^8.7.1",
        "helmet": "^8.3.0",
        "jsonwebtoken": "^9.0.3",
        "multer": "^1.4.5-lts.1",
        "mustache-express": "^1.3.2",
        "prisma": "^7.8.0",
        "sharp": "^0.35.5",
        "zod": "^3.24.3"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@types/bcrypt": "^5.0.0",
        "@types/cors": "^2.8.12",
        "@types/express": "^4.17.13",
        "@types/jsonwebtoken": "^9.0.10",
        "@types/multer": "^1.4.7",
        "@types/mustache-express": "^1.2.2",
        "@types/node": "^24.0.0",
        "@types/pg": "^8.23.1",
        "@types/supertest": "^7.2.1",
        "eslint": "^10.12.0",
        "eslint-config-prettier": "^10.1.8",
        "pg": "^8.23.1",
        "prettier": "^3.9.9",
        "supertest": "^7.3.1",
        "ts-node": "^10.8.0",
        "ts-node-dev": "^2.0.0",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.71.1",
        "vitest": "^5.0.3"
    }
}
